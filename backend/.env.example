# AquaSense AI - Backend Environment Configuration Template
PORT=5000
NODE_ENV=development

# MongoDB Atlas Database Connection URI
MONGO_URI=mongodb://localhost:27017/aquasense_ai

# JSON Web Token Secret Key for Authentication
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters

# Authorized Client Origin for CORS Whitelist
FRONTEND_URL=http://localhost:3000

# Python executable path (Python 3.9+; leave empty to use system default 'python')
PYTHON_PATH=
